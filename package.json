{
  "name": "unicode-eingabe-kiwi3",
  "version": "2.0.8",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --noCheck && vite build && npm run copy-locales",
    "copy-locales": "mkdir -p dist/locales && cp -r src/locales/* dist/locales/",
    "generate:din-locales": "python3 scripts/generate-din-locale-files.py",
    "lint": "prettier src/ tests/ --check && eslint . && vue-tsc --noEmit",
    "format": "prettier src/ tests/ --write",
    "fix": "prettier . --write && eslint . --fix"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@types/webfontloader": "1.6.38",
    "@vueuse/core": "15.0.0",
    "graphemer": "1.4.0",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "vuetify": "4.3.3",
    "webfontloader": "1.6.28"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@tsconfig/node-lts": "24.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "unplugin-fonts": "2.1.0",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
